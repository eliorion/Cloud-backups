#!/usr/bin/env bash
# .githooks/pre-commit — refuse to commit values that were scrubbed from this
# PUBLIC repository.
#
# ── WHY THIS EXISTS ───────────────────────────────────────────────────────────
# This repo is public, but it configures a live fleet. `fleet config tailnet
# <name>` (and anything that calls it, e.g. `fleet buckets add`) writes the REAL
# tailnet name back into flake.nix so the fleet can actually be deployed. That
# working copy is meant to stay DIRTY forever — never committed. One `git add -A`
# republishes it. This hook is the backstop for that.
#
# ── IT STORES NO SECRETS ──────────────────────────────────────────────────────
# Every check matches on SHAPE, never on a literal value, so this file is safe to
# publish. Hardcoding the real tailnet name here would re-leak the exact string
# it is meant to block.
#
# ── SCOPE ─────────────────────────────────────────────────────────────────────
# Checks the FULL staged content of each staged file, not just the added lines:
# what matters is whether the resulting commit's tree would contain the value.
#
#   install (once per clone):            git config core.hooksPath .githooks
#                                        (scripts/setup does this for the devcontainer)
#   bypass (you almost never want to):   git commit --no-verify
set -uo pipefail

findings="$(mktemp)"
trap 'rm -f "$findings"' EXIT

# Drop matches made of a single repeated character — those are this repo's
# placeholders (aaaa…/bbbb…), not real values. Input/output: "LINE:MATCH".
drop_placeholders() {
  awk -F: '{
    m = $2; same = 1
    for (i = 2; i <= length(m); i++)
      if (substr(m, i, 1) != substr(m, 1, 1)) { same = 0; break }
    if (!same) print
  }'
}

record() { # <label> <file>   ; reads "LINE:MATCH" on stdin
  local label="$1" file="$2" hit
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    printf '%s\t%s\t%s\t%s\n' "$label" "$file" "${hit%%:*}" "${hit#*:}" >>"$findings"
  done
}

while IFS= read -r f; do
  [ -n "$f" ] || continue
  # Skip blobs git considers binary.
  git show ":$f" 2>/dev/null | grep -Iq . || continue
  content="$(git show ":$f" 2>/dev/null)" || continue

  # 1. Tailscale tailnet slug — "tail" + >=6 hex digits. Does not match the bare
  #    words tailscale/tailscaled/tailnet ('s' and 'n' are not hex digits), nor
  #    the short doc placeholder tail1234 (only 4 hex digits).
  printf '%s\n' "$content" | grep -nEo 'tail[0-9a-f]{6,}' |
    record 'tailnet name' "$f"

  # 2. Real Tailscale overlay address. 100.64.0.0/10 is the CGNAT range Tailscale
  #    allocates from; every scrubbed placeholder sits in 100.64.0.x, so anything
  #    else in the range is a real node address.
  printf '%s\n' "$content" |
    grep -nEo '\b100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b' |
    grep -v ':100\.64\.0\.' |
    record 'overlay IP' "$f"

  # 3. Real ed25519 public key. Every genuine one starts AAAAC3NzaC1lZDI1NTE5AAAAI
  #    (the encoded "ssh-ed25519" prefix plus the 32-byte length field); this
  #    repo's placeholder deliberately ends AAAAT instead, so it does not match.
  printf '%s\n' "$content" | grep -nEo 'AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]+' |
    record 'ssh public key' "$f"

  # 4. A 64-hex secret: a Garage node ID, or a plaintext rpc_secret/admin_token —
  #    which is cluster-admin-equivalent for Garage (doc 00 §3) and must never be
  #    committed unencrypted.
  printf '%s\n' "$content" | grep -nEo '\b[0-9a-f]{64}\b' | drop_placeholders |
    record 'garage id / 64-hex secret' "$f"
done < <(git diff --cached --name-only --diff-filter=ACM)

[ -s "$findings" ] || exit 0

printf '\n\033[1;31mpre-commit BLOCKED\033[0m — scrubbed value(s) found in staged content:\n\n'
while IFS=$'\t' read -r label file line match; do
  printf '  \033[1m%-26s\033[0m %s:%s  →  %s\n' \
    "$label" "$file" "$line" "$(printf '%s' "$match" | sed -E 's/^(.{4}).*(.{3})$/\1…\2/')"
done <"$findings"

cat <<'MSG'

This repository is PUBLIC. Committing any of the above republishes it.

  unstage the offending file:   git restore --staged <file>
  keep it dirty on purpose:     that is the intended state for flake.nix
  genuinely a false positive:   git commit --no-verify   (then fix this hook)

MSG
exit 1
